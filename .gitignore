# Secrets hygiene (§9) — never commit credentials or keys
.env
*.pem
*.key
*.properties
tiger_openapi_config.properties
*service*account*.json
*credentials*.json
*gcp*.json
config/secrets*
secrets/

# Proprietary OpenD binary — fetched at build time, never committed (§9)
opend/vendor/

# Local working docs — kept on disk, not tracked
BUILD_SPEC.md
HANDOFF.md
# Planning / source-material docs — kept locally, scrubbed from git history
/implementation_plan.md
/moomoo_option_playbook/FEATURES_TO_BUILD.md
/moomoo_option_playbook/moomoo_playbook_summary.md

# Local scratch scripts — kept on disk, not tracked
scratch/

# Local run logs (Windows Task Scheduler daily sync)
logs/

# Lemon8 weekly journal output (generated packages — copy-paste, not tracked)
lemon8_out/

# Ticker → name cache captured from broker positions during the sync
ticker_names.json

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
